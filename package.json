{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:portal && npm run build:duty-clock-pwa",
    "build:portal": "vite build",
    "build:duty-clock-pwa": "node scripts/build-duty-clock-pwa.mjs",
    "deploy:cloudflare": "npm run build && npx --yes wrangler@latest pages deploy dist --project-name bendigo-flying-club-portal --branch main",
    "cloudflare:status": "npx --yes wrangler@latest pages project list",
    "supabase:status": "supabase migration list",
    "supabase:push": "supabase db push",
    "supabase:functions:deploy": "supabase functions deploy --project-ref joarmzswpufrduectjse",
    "audit:migrations": "node scripts/audit-supabase-migrations.mjs",
    "audit:migrations:local": "node scripts/audit-supabase-migrations.mjs --local",
    "check:vouchers": "node scripts/check-voucher-readiness.mjs",
    "smoke:vouchers": "node scripts/smoke-voucher-live.mjs",
    "test:vouchers": "npx --yes deno test --node-modules-dir=false supabase/functions/_shared/trialVoucherReadiness.test.ts",
    "test:calendar": "npx --yes deno test --node-modules-dir=false supabase/functions/_shared/calendar.test.ts",
    "test:address-autocomplete": "npx --yes deno test --node-modules-dir=false supabase/functions/_shared/addressAutocomplete.test.ts",
    "test:membership-welcome-email": "npx --yes deno test --node-modules-dir=false supabase/functions/_shared/membershipWelcomeEmail.test.ts",
    "test:membership-billing": "npx --yes deno test --node-modules-dir=false supabase/functions/_shared/membershipBilling.test.ts",
    "test:xero-account-rules": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/xeroAccountRules.test.ts",
    "test:xero-topup-account-rules": "npx --yes deno test --node-modules-dir=false supabase/functions/_shared/xeroAccountRules.test.ts",
    "test:automation-alerts": "node --test scripts/create-admin-notification.test.mjs",
    "test:duty-break-rules": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test apps/duty-clock/src/utils/breakRequirement.test.ts",
    "test:safety-warning": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/safetyWarningGate.test.ts",
    "test:organisation-locations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/organisationLocationRules.test.ts",
    "test:membership-documents": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/membershipDocumentRules.test.ts",
    "test:membership-settings": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/membershipSettings.test.ts",
    "test:membership-setting-help": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/membershipSettingHelp.test.ts",
    "test:membership-scholarship-contrast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/membershipScholarshipContrast.test.ts",
    "test:student-file-links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/studentFileLinks.test.ts",
    "test:notification-destinations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/notificationDestination.test.ts",
    "test:member-billing-state": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/memberBillingState.test.ts",
    "test:profile-readiness": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/profileReadiness.test.ts",
    "test:settings-deep-links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/settingsDeepLink.test.ts",
    "test:ground-session-billing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/groundSessionBilling.test.ts",
    "test:logbook-filters": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/logbookFilters.test.ts",
    "test:pricing-policy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/pricingPolicy.test.ts",
    "test:xero-pricing-policy": "npx --yes deno test --node-modules-dir=false supabase/functions/_shared/pricingPolicy.test.ts",
    "test:xero-safety": "npx --yes deno test --node-modules-dir=false supabase/functions/_shared/xeroSafety.test.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint . --quiet",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "quality:ratchet": "node scripts/quality-ratchet.mjs",
    "quality": "npm run quality:ratchet && npm run audit:dependencies && npm run audit:migrations:local && npm run test:automation-alerts && npm run test:duty-break-rules && npm run test:safety-warning && npm run test:organisation-locations && npm run test:membership-documents && npm run test:membership-settings && npm run test:membership-setting-help && npm run test:membership-scholarship-contrast && npm run test:student-file-links && npm run test:notification-destinations && npm run test:member-billing-state && npm run test:profile-readiness && npm run test:settings-deep-links && npm run test:ground-session-billing && npm run test:logbook-filters && npm run test:pricing-policy && npm run test:xero-account-rules && npm run test:xero-topup-account-rules && npm run test:xero-pricing-policy && npm run test:xero-safety && npm run test:address-autocomplete && npm run test:membership-welcome-email && npm run test:membership-billing && npm run duty-pwa:check && npm run build",
    "test:acceptance:recovery": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-recovery-acceptance.ps1",
    "test:acceptance:browserstack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-recovery-acceptance.ps1 -BrowserStack",
    "preview": "vite preview",
    "duty-pwa:start": "npm --prefix apps/duty-clock run start -- --web",
    "duty-pwa:check": "npm --prefix apps/duty-clock run check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "@types/node": "^24.3.0",
    "@types/react-big-calendar": "^1.16.2",
    "@types/react-router-dom": "^5.3.3",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.12",
    "lucide-react": "^0.344.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.18",
    "browserstack-local": "^1.5.13",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.4.35",
    "selenium-webdriver": "^4.46.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
