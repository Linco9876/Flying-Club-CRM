/*
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://challenges.cloudflare.com; frame-src https://js.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com; form-action 'self' https://checkout.stripe.com; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(self), encrypted-media=(), fullscreen=(self), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(self), publickey-credentials-get=(self), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/auth-aircraft-sunset.webp
  Cache-Control: public, max-age=31536000, immutable

/aircraft-icons/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/pwa-icon-*
  Cache-Control: public, max-age=31536000, immutable

/notification-badge.png
  Cache-Control: public, max-age=604800

/duty-clock/app/notification-badge.png
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/duty-clock/app/duty-clock-sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /duty-clock/app/

/duty-clock/app/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
